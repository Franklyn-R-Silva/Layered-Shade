{
  "name": "layered-shade",
  "version": "2.2.0",
  "description": "Layered Shade - Box Shadow Generator for CSS & Flutter (Svelte 5 + Vite + TypeScript)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ --max-warnings 0",
    "lint:fix": "eslint src/ --fix"
  },
  "keywords": [
    "box-shadow",
    "css",
    "flutter",
    "dart",
    "shadow-generator"
  ],
  "author": "Franklyn R. Silva",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "@tsconfig/svelte": "^5.0.9",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "svelte": "^5.59.2",
    "svelte-check": "^4.7.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.4.0",
    "vitest": "^5.1.1"
  }
}
